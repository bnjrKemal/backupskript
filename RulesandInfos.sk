command /kitap [<integer>]:
	trigger:
		set {_book} to a new book
		add page "%nl%%nl%%nl%%nl%%nl%&9          &l» &1&lİletişim&f &9&l«%nl%%nl%          &4/discord%nl%%nl%%nl%%nl%%nl%%nl%&7           Sayfayı çevirin." to {_book}
		add page "&d&l» &5&l&nAdakit&f &d&l«%nl%&0Oyunda yeniyseniz%nl%&4/adakit &0yazarak 3 demir spawner alabilirsiniz.%nl%Daha fazlası için &4/spawnersüre&0 yazarak istenen sürelerinde oyunda durursanız yeni spawnerlerini kazanabilirsiniz.%nl%&d&l» &5&l&nAdafly&r &d&l«%nl%&0Adalarda uçmak için &4/adafly&0." to {_book}
		add page "&d&l» &5&l&nGörev Sistemi&f &d&l«%nl%&0Her hangi bir görevini bitirdiğinizde görev ödüllerini alabilirsiniz. Görev ödüllerin içinde spawnerler vardır.%nl%Kullanımı: &4/görev" to {_book}
		add page "&d&l» &5&l&nEnchMarket&f &d&l«%nl%&0EnchMarket, elinizdeki aletlerin büyülerini daha iyi geliştirebilmenizi sağlayan özel bir sistemdir. Aletlerinizin büyülerini geliştirmek için &4/takas&0'tan veya &4/kit&0'ten EXP toplamanız gerekir. &4/enchmarket&0 yazarak veya büyü masasına tıklayarak göz atabilirsiniz." to {_book}
		add page "&d&l» &5&l&nAçık Arttırma&f &d&l«%nl%&0Açık Arttırma kullanmanız için &4/açıkarttırma&0 yazarak 20 M oyun parasını ödemelisiniz.%nl%&nBoş yere kullananlar uyarılmaksızın Açık Arttırma yetkisi alınacaktır.%nl%&0Kullanım kılavuzu &4/auc%nl%&d&l» &5&l&nObsidyen Sistemi&f &d&l«%nl%&0/obsidyenbilgi" to {_book}
		add page "&d&l» &5&l&nRütbe Sistemi&f &d&l«%nl%&0Yeni rütbelere atlamak için &4/is level&0 yazarak yeni güncellenen ada levelinize göre otomatikmen rütbe verilmektedir. Ada levellerine bakmak için &4/lord&0 yazabilirsiniz. Skyblock görevlerini(/c) yapmanıza gerek yoktur." to {_book}
		add page "&d&l» &5&l&nMarket&f &d&l«%nl%&4/market. &0Itemlerini satmak için &4/sell all&0.%nl%Market kurmayı bilmeyenler için;%nl%Sandığın yüzündeki tabela bu şekilde olacak; %nl%&7%player%%nl%&8<item adeti>%nl%&7<satış miktarı>:<alış miktarı>%nl%&8<item kodu>&4(/iteminfo)" to {_book}
		add page "&d&l» &5&l&nDeğerli Itemler&f &d&l«%nl%&0Ada leveli yükseltecek ve değerli itemler;%nl%&5» &0Sünger 2016 ada lvl%nl%&5» &0End Taşı 1008 ada lvl%nl%&5» &0Elmas Blok 18 ada lvl%nl%&5» &0Zümrüt Blok 9 ada lvl%nl%&5» &0Altın Blok 3 ada lvl%nl%&5» &0Demir Blok 1 ada lvl%nl%&5» &0&k&liii&3&l Nyks &0&k&liii&4 /takas%nl%&5» &0&k&liii&2&l B&a&lo&2&ln&a&lu&2&ls &0&k&liii&4 /takas%nl%&5» &0Diğer itemlerin ada leveline bakmak için &4/is value&0." to {_book}
		add page "&d&l» &5&l&nOylama Sistemi&f &d&l«%nl%&0Oylama yaptığınız zaman hem bizi desteklemiş hem kendini ödüllendirtmiş oluyorsunuz. Ve her gün düzenli oylama yapmayı unutmayın. Oylama yapmak için siteye girip oyun içindeki kendi isminizi yazmanız yeterlidir. Oylama sitesi için &4/vote." to {_book}
		add page "&d&l» &5&l&nSanal Pazar&f &d&l«%nl%&0Güvenmediğiniz ve tanımadığınız oyuncularla bu sistemin sayesinde itemlerini ticaret yapabilirsiniz. Tek yapmanız gereken, itemlerin sahte olup olmadığını iyi kontrol etmeniz.%nl%Komutlar (&4/ah&0)%nl%&4/ah sell <fiyat>&0%nl%&4/ah expel&0." to {_book}
		add page "&d&l» &5&l&nCoin Sistemi&f &d&l«%nl%&4/takas&0'ta ki takas birimi &0&l&kiii&3&l Nyks &0&l&kiii&0'dir. Zararlı moblarını öldürerek (en iyisi MobTrap yaparak) veya kırıktaş kırarak %%1 şansla şanslı kutusunu yakalayarak içinden bir kaç &0&l&kiii&3&l Nyks &0&l&kiii&0 coinlerini çıkarabilirsiniz.%nl%&732 Nyks &c&l= &71 Bonus" to {_book}
		add page "&d&l» &5&l&nSüre ödülü&f &d&l«%nl%&0Komut kullanımı: &4/sure&0.%nl%Oyun içinde oyundan çıkmadan 1 saat durduğunuzda size 8 sünger ödül olarak verecektir. Fakat ödülü almak için ve ödülü başlatmak için &4/sure&0 butona basmanız gerekir. 1 saati doldurup oyundan çıkarsanız ödülünü de kaybetmezsiniz." to {_book}
		add page "&d&l» &5&l&nKalanlar-1&f &d&l«%nl%&2Envanter Event&4; &0Her 6 saatte 1 event otomatikmen gerçekleştirmektedir. 1 Demir Spawner, 16 End Taşı ve 500 K para.%nl%&2Event Kasası Eventi&4; &0Haftaiçi her gün 2 saatte ve haftasonu 4 saatte 1 event kasası event gerçekleşir. Event Kasası vermektedir." to {_book}
		add page "&d&l» &5&l&nKalanlar-2&f &d&l«%nl%&2Kırıktaştan Çıkarabilecek Madenler&4; &0demir blok, altın blok, zümrüt blok, elmas blok veya şanslı kutusu.%nl%&2Kelime oyunu&4; &0Sunucuda 5 kişiden fazla olduğu zaman 15 dakikada 1 kelime oyunu başlatılacaktır. Verilecek ödüller; 8 End Taşı." to {_book}
		add page "%nl%%nl%%nl%%nl%%nl%%nl%&4/bilgi%nl%/kural" to {_book}
		open book {_book} to player
command /kural:
	trigger:
		set {_book} to a new book
		add page "&c&l» &4&l&nKurallar&f &c&l«%nl%&0Bu sunucudaki tüm oyuncular kurallarını okumuş ve kabul etmiş sayılacaktır.%nl%%nl%%nl%%nl%%nl%%nl%&4&l   Sayfayı çevirin." to {_book}
		add page "&7&l##1&0 İyi ve saygılı davran.%nl%&7&l##2&0 Küfür, argo gibi uygunsuz kelimelerini kullanma. (Uygunsuz nick ile oyuna girmek ban sebebidir.)%nl%&7&l##3&0 Sohbeti kirletecek ve başkalarını rahatsız edecek şekilde bir mesaj kullanma." to {_book}
		add page "&7&l##4&0 Başkalarını rahatsız etme ve başkalarının işini engelleme.%nl%&7&l##5&0 Yetkililerini boş yere meşgul etme. Sorunu direk yaz.%nl%&7&l##6&0 Yetkili yardımı yasaktır.%nl%&7&l##7&0 Hakaret etmek ve reklam yapmak ban sebebidir." to {_book}
		add page "%nl%%nl%%nl%%nl%%nl%%nl%&4/bilgi%nl%/kitap" to {_book}
		open book {_book} to player
command /bilgi:
	trigger:
		set {_book} to a new book
		add page "&b&l» &3&l&nGenel Bilgi&f &b&l«%nl%&2»&0 Ada Menüsünü açar &4/is%nl%&2»&0 Adana gider &4/is go%nl%&2»&0 Adanı sıfırlar &ctüm itemler dahil &4/is restart%nl%&2»&0 Ada spawn noktasını ayarlar &4/is sethome%nl%&2»&0 Ada levelini gösterir &4/is level%nl%&2»&0 Oyunucun ada levelini gösterir &4/is level <oyuncu>" to {_book}
		add page "%nl%&2»&0 En iyi adaları listeler &4/is top%nl%&2»&0 Ada warplarını listeler &4/is warps%nl%&2»&0 Oyuncunun adasına gider &4/is warp <oyuncu>%nl%&2»&0 Yazdığın kişiyi adaya davet eder &4/is invite <oyuncu>%nl%&2»&0 Ada takım arkadaşları gösterir &4/is team" to {_book}
		add page "%nl%&2»&0 Adada gezen arkadaşını tekmeler &4/is expel <oyuncu>%nl%&2»&0 Adadan ayrılmak için &4/is leave%nl%&2»&0 Takımdan arkadaşını atar &4/is kick <oyuncu>%nl%&2»&0 Gelen ada davet isteğini &akabul &f/ &creddeder &4/is <&aaccept&1/&creject&4>%nl%&2»&0 Arkadaşını adaya devreder &4/is makeleader <oyuncu>" to {_book}
		add page "%nl%&2»&0 Adadan oyuncuyu banlar &4/is ban <oyuncu>%nl%&2»&0 Banladığın oyuncunun banını açar &4/is unban <oyuncu>%nl%&2»&0 Adayı kilitleyerek koruma altına alır &4/is lock%nl%&2»&0 Paranı gösterir &4/money" to {_book}
		add page "%nl%&2»&0 Arkadaşına para gönderir &4/pay <isim> <miktar>%nl%&2»&0 Birine ışınlanma isteği gönderir &4/tpa <isim>%nl%&2»&0 Işınlanma isteği kabul eder &4/tpaccept%nl%&2»&0 Birine mesaj atar &4/msg <isim> <mesaj>%nl%&2»&0 Menü açar &4/menu%nl%&2»&0 Lord sistemi &4/lord" to {_book}
		add page "%nl%%nl%%nl%%nl%%nl%%nl%&4/kitap%nl%/kural" to {_book}
		open book {_book} to player
